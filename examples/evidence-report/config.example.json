{
  "mcp_url": "https://mcp.example.invalid/mcp",
  "a2a_url": "https://agent.example.invalid/a2a",
  "mcp_token_env": "MEDA_MCP_TOKEN",
  "a2a_token_env": "MEDA_A2A_TOKEN",
  "ca_file": "/absolute/path/to/trusted-ca.pem",
  "principal": "example-user",
  "tenant": "example-tenant",
  "grants": [
    "readEvidence",
    "submit",
    "observe",
    "provideInput",
    "cancel"
  ],
  "allowed_documents": [
    "evidence-42"
  ],
  "expected_revision": 1,
  "tool_descriptor": {
    "name": "evidence.read",
    "description": "Read the fixed synthetic evidence document.",
    "inputSchema": {
      "properties": {
        "documentId": {
          "title": "Documentid",
          "type": "string",
          "x-mcp-header": "DocumentId"
        }
      },
      "required": [
        "documentId"
      ],
      "title": "evidence_readArguments",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Fact": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "title": "Id",
              "type": "string"
            },
            "value": {
              "title": "Value",
              "type": "string"
            }
          },
          "required": [
            "id",
            "value"
          ],
          "title": "Fact",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "title": "Documentid",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "documentId",
        "revision",
        "facts"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "agent_card": {
    "name": "Meda D0 deterministic report agent",
    "description": "Select supplied evidence facts without a model.",
    "supportedInterfaces": [
      {
        "url": "https://agent.example.invalid/a2a",
        "protocolBinding": "JSONRPC",
        "protocolVersion": "1.0"
      }
    ],
    "version": "1.0.0",
    "capabilities": {
      "streaming": false,
      "pushNotifications": false
    },
    "securitySchemes": {
      "fixtureBearer": {
        "httpAuthSecurityScheme": {
          "scheme": "bearer"
        }
      }
    },
    "securityRequirements": [
      {
        "schemes": {
          "fixtureBearer": {}
        }
      }
    ],
    "defaultInputModes": [
      "application/json"
    ],
    "defaultOutputModes": [
      "application/json"
    ],
    "skills": [
      {
        "id": "evidence-report",
        "name": "Evidence report",
        "description": "Return the selected evidence in request order.",
        "tags": [
          "fixture"
        ]
      }
    ]
  },
  "limits": {
    "root_seconds": 15,
    "request_seconds": 2,
    "cleanup_seconds": 1,
    "max_requests": 16,
    "cleanup_requests": 2,
    "max_response_bytes": 65536,
    "max_request_bytes": 65536,
    "max_inbound_bytes": 262144,
    "max_depth": 16,
    "max_events": 16,
    "max_event_bytes": 16384,
    "max_pages": 2,
    "max_polls": 3,
    "poll_interval": 0.1
  }
}
