      "id": "maximum-default",
      "summary": "Return the largest item, or fallback only when the list is empty.",
      "operation": "solve",
      "languages": {
        "meda": {
          "source": "operation solve(items: List<Int>, fallback: Int) -> Int effects [] {\n  var largest = fallback\n  for item in items {\n    if item > largest { largest = item }\n  }\n  return largest\n}\n",
          "solution": "{\n  var largest = fallback\n  var first = true\n  for item in items {\n    if first or item > largest { largest = item }\n    first = false\n  }\n  return largest\n}"
        },
        "python": {
          "source": "def solve(*, items: list[int], fallback: int) -> int:\n    largest = fallback\n    for item in items:\n        if item > largest:\n            largest = item\n    return largest\n",
          "solution": "    largest = fallback\n    first = True\n    for item in items:\n        if first or item > largest:\n            largest = item\n        first = False\n    return largest"
