    {
      "id": "clamp",
      "summary": "Return value limited to the inclusive interval [lower, upper]. Inputs satisfy lower <= upper.",
      "operation": "solve",
      "languages": {
        "meda": {
          "source": "operation solve(value: Int, lower: Int, upper: Int) -> Int effects [] {\n  return value\n}\n",
          "solution": "{\n  if value < lower { return lower }\n  if value > upper { return upper }\n  return value\n}"
        },
        "python": {
          "source": "def solve(*, value: int, lower: int, upper: int) -> int:\n    return value\n",
          "solution": "    if value < lower:\n        return lower\n    if value > upper:\n        return upper\n    return value"
        }
      },
      "visible": [
