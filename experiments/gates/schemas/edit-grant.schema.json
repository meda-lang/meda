{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "grantId": {
      "type": "string"
    },
    "baseRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "allowedTargets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowSpecificationRoots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "checkFile": {
      "type": "string"
    },
    "checkDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "testIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expiresAt": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "version",
    "grantId",
    "baseRevision",
    "allowedTargets",
    "allowSpecificationRoots",
    "checkFile",
    "checkDigest",
    "testIds",
    "expiresAt"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
