{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "CommonJS",
    "moduleResolution": "Node", "strict": true, "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true, "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "outDir": "dist", "types": ["node"]
  },
  "include": ["*.ts"]
}
