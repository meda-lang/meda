      "operation": "solve",
      "languages": {
        "meda": {
          "source": "import std.list as list\noperation solve(items: List<Int>, threshold: Int) -> List<Int> effects [] {\n  return items\n}\n",
          "solution": "{\n  var output: List<Int> = []\n  for item in items {\n    if item >= threshold { output = list.append(items: output, value: item) }\n  }\n  return output\n}"
        },
        "python": {
          "source": "def solve(*, items: list[int], threshold: int) -> list[int]:\n    return items\n",
          "solution": "    output = []\n    for item in items:\n        if item >= threshold:\n            output = output + [item]\n    return output"
